NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://folia_app:CHANGE_ME@localhost:5432/folia_dev?schema=public"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# JWT secrets — generate real random values for any non-local environment,
# e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_ME_dev_only_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_dev_only_refresh_secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS="http://localhost:5173"

# Razorpay (Phase 1 — payments). Optional at boot — the app still starts
# with none of these set, but real card/UPI/net-banking/wallet checkout
# will fail loudly until they're real values. Get test-mode keys from
# the Razorpay dashboard: Settings -> API Keys -> Generate Test Key.
# RAZORPAY_WEBHOOK_SECRET comes from Settings -> Webhooks -> Create
# Webhook, pointing at {API_URL}/api/v1/payments/webhook.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Resend (Phase 3 — customer emails). Optional at boot — the app still
# starts with no key set, but password reset, email verification, and
# order/payment emails will silently fail to send (logged, never breaks
# the request that triggered them) until this is a real key. Get one
# from the Resend dashboard: API Keys -> Create API Key. The default
# RESEND_FROM_EMAIL below (Resend's own shared sandbox address) works
# immediately with no setup but can only deliver to the Resend account's
# own verified email — verify a real sending domain before relying on
# delivery to arbitrary customer inboxes.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Folia <onboarding@resend.dev>"

# Absolute origin used to build links inside emails (reset-password,
# verify-email, order pages) — an email client has no notion of
# "relative to this site" the way an in-app link does.
FRONTEND_URL="http://localhost:5173"

# Shiprocket (Phase 5 — real courier/fulfillment). Optional at boot — the
# app still starts with none of these set: the cart-page shipping estimate
# gracefully falls back to a flat-rate heuristic, but the admin "ship this
# order" action will fail loudly until they're real values. Get credentials
# from the Shiprocket dashboard (email/password login, not an API key) —
# SHIPROCKET_PICKUP_LOCATION is the pickup address nickname registered
# under Settings -> Pickup Addresses; SHIPROCKET_PICKUP_PINCODE is that
# address's PIN code, used for rate/serviceability lookups.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_PICKUP_PINCODE=""
