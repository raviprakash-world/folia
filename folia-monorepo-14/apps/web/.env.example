# Phase 10 (backend integration), auth domain — see INTEGRATION.md at
# the repo root for the full story. Live-verified working (register,
# login, session, real cookie, real browser) as of this session.
VITE_REAL_AUTH_API=false

# Phase 14 (backend integration), catalog domain (products, categories,
# collections — all public, read-only GET endpoints). Live-verified
# working the same way as auth, as of this same session (real 24-product
# catalog, real HTTP caching via 304s, confirmed in a real browser).
VITE_REAL_CATALOG_API=false

# Phase 14 (backend integration, reviews domain, public/read-only).
# Live-verified working the same way as auth and catalog, as of this
# same session.
VITE_REAL_REVIEWS_API=false

# Phase 14 (backend integration, cart domain). Different in kind from
# the three above: cart previously made NO backend calls at all (pure
# local Zustand state), so this required genuinely new code, not just a
# routing switch. Scope is deliberately narrower too — only addItem and
# loading the cart on the /cart page are wired to the real backend;
# removeItem/updateQuantity/clearCart remain local-only, a stated cut,
# not an oversight. Written and reviewed carefully, including catching a
# real DTO mismatch (variantId must be omitted, not sent as null) before
# it could have caused a live validation failure — but treat this with
# the same "not yet live-verified" caution as any new code until it's
# actually been tried.
VITE_REAL_CART_API=false

# Phase 14 (backend integration, wishlist domain). Same "genuinely new
# code, not a routing switch" situation as cart. One real difference
# from cart worth knowing: the backend's wishlist endpoints require
# being logged in (no guest fallback — confirmed directly against the
# controller source, which uses @CurrentUser() not
# @OptionalCurrentUser()), so this only works when VITE_REAL_AUTH_API is
# also on and you're actually signed in. Not yet live-verified.
VITE_REAL_WISHLIST_API=false

# Phase 14 (backend integration, addresses domain). Simpler than
# cart/wishlist: addressStore.ts already called the real service layer
# for every operation before this flag existed, so this needed zero
# store code changes — just this exclusion plus the matching proxy
# rule. Response shape checked directly against the real backend's
# toPublicAddress() before enabling, not assumed. Not yet live-verified.
VITE_REAL_ADDRESSES_API=false

# Phase 14 (backend integration, search domain). A genuine architectural
# choice, not just a routing switch: search already called the real
# products endpoint (once VITE_REAL_CATALOG_API is on) for candidates,
# then ranked them client-side. This flag switches to the backend's
# dedicated /search endpoint instead, which does the same ranking
# server-side — with the real benefit of genuine wishlist/purchase
# signals for logged-in users instead of local heuristics. Blog-post
# matching stays client-side either way: blog isn't a real backend
# concept at all (confirmed directly against the schema, Phase 7).
# Trending SEARCH TERMS (distinct from trending products) are a stated,
# separate cut — not wired up this round. Not yet live-verified.
VITE_REAL_SEARCH_API=false

# Phase 14 (backend integration, recommendations domain). Only 3 of the
# frontend's 5 recommendation hooks have a real backend match: similar,
# frequently-bought-together, personalized. useCustomersAlsoViewed and
# useCartComplements stay client-side-only regardless of this flag —
# RecommendationsController has no matching endpoint for either concept
# (confirmed directly against the source, not assumed). Not yet
# live-verified.
VITE_REAL_RECOMMENDATIONS_API=false

# Phase 15 (backend integration, notifications domain) — the first
# domain tonight that needed a real new backend built from scratch, not
# just frontend wiring against something that already existed. List,
# unread count, mark-read, mark-all-read, and delete all go through the
# real backend when this is on. "Archive" stays a small, local-only
# overlay regardless of this flag — a real UI feature the initial audit
# missed (it only checked creation call sites, not this separate
# interaction), discovered too late to justify reopening the already-
# built-and-tested schema/service/seed data for. Not yet live-verified.
VITE_REAL_NOTIFICATIONS_API=false

# Phase 15 (backend integration, coupons + shipping domains). The
# cleanest integration of this whole session: the real backend's error
# messages are a deliberate byte-for-byte match to the frontend's own
# (confirmed directly against both services' source before writing
# this), so couponService.ts/shippingService.ts branch internally and
# still throw the same CouponError/ShippingError classes either way —
# cartStore.ts, which calls them, needed zero changes at all. Not yet
# live-verified.
VITE_REAL_COUPONS_API=false
VITE_REAL_SHIPPING_API=false

# Phase 15/16 (backend integration, orders domain — the largest piece
# of this whole session). Covers: real checkout submission (replacing
# entirely client-fabricated orders — fake IDs, fake tracking, fake
# pricing — with the real backend's authoritative computation and
# persistence), order history, order detail, cancel, return, tracking,
# customer notes, and reorder. Tracking needed zero contract changes —
# TrackingService.simulate() was deliberately ported as an exact copy of
# the frontend's own mock logic, confirmed field-by-field before
# enabling this. A real, subtle bug caught along the way: after a real
# reorder, cartStore's local state is now explicitly re-synced from the
# server before navigating to checkout — without that, checkout would
# have shown the pre-reorder cart, since /checkout/shipping is reached
# without ever visiting /cart first. Not yet live-verified.
VITE_REAL_ORDERS_API=false

# Where the real backend is running, if any flag above is true.
VITE_API_PROXY_TARGET=http://localhost:3000
